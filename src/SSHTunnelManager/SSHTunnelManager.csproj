<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>SSH Tunnel Manager</AssemblyTitle>
    <Company>AI开发工具</Company>
    <Product>SSH Tunnel Manager</Product>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyTools.Core\TinyTools.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
  </ItemGroup>

  <!-- UseWindowsForms pulls in the NotifyIcon assembly, but its implicit global
       usings (System.Windows.Forms / System.Drawing) clash with WPF's own types
       (MessageBox, Application, Brush, ...). Drop those implicit usings and add
       them explicitly only where needed (see MainWindow.xaml.cs). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
