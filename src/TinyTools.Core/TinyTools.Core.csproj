<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>TinyTools Core</AssemblyTitle>
    <Company>AI开发工具</Company>
    <Product>TinyTools</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!--
    Stage 1 keeps the proven implementation files in their legacy folders while
    changing assembly ownership. WPF and WinUI now consume the same UI-neutral
    Core assembly. A later namespace cleanup can move these files without mixing
    that mechanical change with the framework migration.
  -->
  <ItemGroup>
    <Compile Include="..\SSHTunnelManager\Models\**\*.cs" Link="Models\SSH\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\SSHTunnelManager\Services\**\*.cs" Link="Services\SSH\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\HandleViewer\Models\**\*.cs" Link="Models\Inspection\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\HandleViewer\Services\**\*.cs" Link="Services\Inspection\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
