<Page
    x:Class="TinyTools.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="22" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="SavedBar" IsOpen="False" IsClosable="True" Severity="Success" Message="设置已保存。" />

            <TextBlock Text="外观与启动" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="ThemeBox" Header="应用主题" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="跟随系统" Tag="System" />
                    <ComboBoxItem Content="浅色" Tag="Light" />
                    <ComboBoxItem Content="深色" Tag="Dark" />
                </ComboBox>
                <ComboBox x:Name="StartPageBox" Grid.Column="1" Header="启动页面" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="上次使用" Tag="LastUsed" />
                    <ComboBoxItem Content="SSH 隧道" Tag="Tunnel" />
                    <ComboBoxItem Content="端口与进程" Tag="HandleViewer" />
                </ComboBox>
            </Grid>
            <CheckBox x:Name="AutoStartMinimizedBox" Content="启动后直接最小化到托盘" />

            <TextBlock Text="窗口与托盘" Style="{StaticResource SubtitleTextBlockStyle}" />
            <CheckBox x:Name="MinimizeToTrayBox" Content="关闭窗口时最小化到托盘" />
            <CheckBox x:Name="ConfirmBeforeExitBox" Content="退出前询问确认" />
            <CheckBox x:Name="ShowTrayNotificationsBox" Content="显示托盘气泡通知" />

            <TextBlock Text="端口查看器" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ComboBox x:Name="PortRefreshBox" Header="自动刷新" Width="280" HorizontalAlignment="Left">
                <ComboBoxItem Content="关闭" Tag="0" />
                <ComboBoxItem Content="每 5 秒" Tag="5" />
                <ComboBoxItem Content="每 10 秒" Tag="10" />
                <ComboBoxItem Content="每 30 秒" Tag="30" />
            </ComboBox>
            <CheckBox x:Name="ShowSystemProcessesBox" Content="显示系统进程" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="保存设置" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="恢复默认" Click="Reset_Click" />
                <Button Content="打开数据目录" Click="OpenDataDirectory_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
