<Page
    x:Class="TinyTools.WinUI.Pages.TunnelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">

    <Grid x:Name="LayoutRoot" Padding="24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogRowDefinition" Height="0.38*" MinHeight="110" MaxHeight="240" />
        </Grid.RowDefinitions>

        <!-- 页头：窄屏时操作按钮自动折行 -->
        <Grid x:Name="HeaderGrid" RowSpacing="10" ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="SSH 隧道" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SummaryText" Opacity="0.65" />
            </StackPanel>

            <StackPanel
                x:Name="HeaderActions"
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button Content="全部启动" Click="StartAll_Click" />
                <Button Content="全部停止" Click="StopAll_Click" />
                <Button Content="新增隧道" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="PageMessage" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2">
            <TextBlock
                x:Name="EmptyHint"
                Text="还没有隧道。选择“新增隧道”开始配置。"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.65" />
            <ListView x:Name="TunnelList" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="14,12"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <!-- 两行自适应卡片：上行信息，下行端口/状态与操作，窄屏绝不裁切 -->
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Text="{Binding Config.Name}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding MaskedHost}"
                                            Opacity="0.68"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="1"
                                        Padding="10,4"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="端口" Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Config.RemotePort}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="→" Opacity="0.65" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Config.LocalPort}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="{Binding StatusText}"
                                        VerticalAlignment="Center"
                                        Opacity="0.85"
                                        TextTrimming="CharacterEllipsis" />

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                        <Button Content="启动" IsEnabled="{Binding CanStart}" CommandParameter="{Binding}" Click="Start_Click" />
                                        <Button Content="停止" IsEnabled="{Binding CanStop}" CommandParameter="{Binding}" Click="Stop_Click" />
                                        <Button Content="编辑" CommandParameter="{Binding}" Click="Edit_Click" />
                                        <Button Content="删除" CommandParameter="{Binding}" Click="Delete_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 日志标题与折叠开关 -->
        <Grid Grid.Row="3" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="连接日志" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ToggleLogButton" Content="收起" Click="ToggleLogs_Click" />
                <Button Content="复制" Click="CopyLogs_Click" />
                <Button Content="清空" Click="ClearLogs_Click" />
            </StackPanel>
        </Grid>

        <ListView
            x:Name="LogList"
            Grid.Row="4"
            SelectionMode="None"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="12"
            CornerRadius="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}" />
    </Grid>
</Page>
