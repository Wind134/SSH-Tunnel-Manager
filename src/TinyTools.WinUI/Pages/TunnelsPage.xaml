<Page
    x:Class="TinyTools.WinUI.Pages.TunnelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SSH 隧道" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SummaryText" Opacity="0.65" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="全部启动" Click="StartAll_Click" />
                <Button Content="全部停止" Click="StopAll_Click" />
                <Button Content="新增隧道" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="PageMessage" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyHint" Text="还没有隧道。选择“新增隧道”开始配置。"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" />
            <ListView x:Name="TunnelList" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Config.Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding MaskedHost}" Opacity="0.65" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="端口映射" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Config.RemotePort}" />
                                        <TextBlock Text="→" />
                                        <TextBlock Text="{Binding Config.LocalPort}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="状态" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="启动" IsEnabled="{Binding CanStart}" CommandParameter="{Binding}" Click="Start_Click" />
                                    <Button Content="停止" IsEnabled="{Binding CanStop}" CommandParameter="{Binding}" Click="Stop_Click" />
                                    <Button Content="编辑" CommandParameter="{Binding}" Click="Edit_Click" />
                                    <Button Content="删除" CommandParameter="{Binding}" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="连接日志" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="复制" Click="CopyLogs_Click" />
                <Button Content="清空" Click="ClearLogs_Click" />
            </StackPanel>
        </Grid>
        <ListView x:Name="LogList" Grid.Row="4" SelectionMode="None" FontFamily="Cascadia Mono, Consolas"
                  Background="{ThemeResource LayerFillColorDefaultBrush}" />
    </Grid>
</Page>
