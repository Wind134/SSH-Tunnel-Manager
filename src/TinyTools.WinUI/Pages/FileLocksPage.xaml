<Page
    x:Class="TinyTools.WinUI.Pages.FileLocksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">

    <Grid
        x:Name="LayoutRoot"
        Padding="24,20"
        RowSpacing="12"
        AllowDrop="True"
        DragOver="Page_DragOver"
        Drop="Page_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="文件和文件夹占用" Style="{StaticResource TitleTextBlockStyle}" />

        <Border
            Grid.Row="1"
            Padding="16,12"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7C3;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel>
                    <TextBlock Text="将文件或文件夹拖到这里" FontWeight="SemiBold" />
                    <TextBlock Text="拖入后会立即查询；也可以在下方选择或输入路径。" Opacity="0.68" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 响应式路径栏：窄屏时操作按钮自动折行 -->
        <Grid Grid.Row="2" RowSpacing="8" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="PathBox"
                Grid.Row="0"
                Grid.Column="0"
                PlaceholderText="输入文件或文件夹完整路径，按 Enter 查询"
                KeyDown="PathBox_KeyDown" />

            <StackPanel
                x:Name="ActionButtons"
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button Content="选择文件" Click="ChooseFile_Click" />
                <Button Content="选择文件夹" Click="ChooseFolder_Click" />
                <Button
                    x:Name="QueryButton"
                    Content="查询"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="QueryButton_Click" />
                <Button
                    x:Name="CancelButton"
                    Content="取消"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 表格区：宽屏铺满拉伸，窄屏可横向滚动 -->
        <ScrollViewer
            x:Name="TableScrollViewer"
            Grid.Row="3"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            SizeChanged="TableScrollViewer_SizeChanged">
            <Grid x:Name="TableHost" MinWidth="720">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="12,8"
                    ColumnSpacing="12"
                    CornerRadius="6,6,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PID" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="进程" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="应用名称" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="启动时间" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="可执行路径" Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>

                <ListView x:Name="LockList" Grid.Row="1" SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="34" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="12">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="打开进程所在目录" Tag="{Binding}" Click="OpenDirectory_Click" />
                                        <MenuFlyoutItem Text="强制终止进程" Tag="{Binding}" Click="TerminateProcess_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="复制详情" Tag="{Binding}" Click="CopyDetails_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Pid}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ProcessName}" />
                                <TextBlock Grid.Column="2" Text="{Binding AppName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding AppName}" />
                                <TextBlock Grid.Column="3" Text="{Binding StartTime}" />
                                <TextBlock Grid.Column="4" Text="{Binding ProcessPath}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ProcessPath}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="QueryProgress" Width="18" Height="18" IsActive="False" />
            <TextBlock x:Name="QueryStatus" Grid.Column="1" Opacity="0.7" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
